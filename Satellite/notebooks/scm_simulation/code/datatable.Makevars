# Build flags for installing data.table into /data/wang/junh/envs/rsynth (plan use-nature-skills-analyze-wiggly-coral.md,
# departure 1, Jun "Into rsynth" and "Install anyway", 2026-11-04). rsynth ships libz.so.1 (zlib 1.3.2) but no zlib.h,
# so the header comes from the satellite environment, which carries the same zlib 1.3.2.
#   R_MAKEVARS_USER=/data/wang/junh/githubs/latent-synthetic-control/Satellite/notebooks/scm_simulation/code/datatable.Makevars \  (absolute: R builds in a temporary folder)
#     /data/wang/junh/envs/rsynth/bin/Rscript -e 'install.packages("data.table", repos = "https://cloud.r-project.org")'
CPPFLAGS += -I/data/wang/junh/envs/satellite/include
LDFLAGS += -L/data/wang/junh/envs/satellite/lib
